{
  "expo": {
    "name": "Street",
    "slug": "SkillLink-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/street_logo.png",
    "scheme": "streetapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/street_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SkillLinkApp",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "streetapp" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/street_logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Street uses your location to help you share where the work should be done and to let providers navigate to you."
        }
      ],
      "react-native-compressor",
      "expo-video",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "714c044b-a6a0-435a-8df9-0af198359c3d"
      }
    }
  }
}